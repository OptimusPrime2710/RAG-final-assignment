{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "type": "object",
  "required": ["plan_id", "version", "status", "source", "use_case", "inputs", "goals"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["pending", "ready", "running", "completed", "failed", "blocked", "skipped", "paused"]},
    "source": {"type": "object"},
    "use_case": {"type": "object"},
    "inputs": {"type": "array"},
    "goals": {"type": "array"}
  }
}
